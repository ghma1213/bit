NODE_ENV=development
PORT=3000

# Postgres (docker-compose.yml 기준)
DATABASE_URL=postgresql://bit:bit_dev_password@localhost:5433/bit

# 세션 (32자 이상 랜덤 문자열: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32
SESSION_MAX_AGE_MS=1800000

# 프론트엔드 origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# 시드용 최초 관리자 (개발 전용 값)
# 로그인 ID 는 사번. 이메일은 선택(연락용)
SEED_ADMIN_EMPLOYEE_NUMBER=ADM-001
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345

# 샘플 직원(EMP-001~010) 공통 비밀번호 — 개발 전용, production 에서는 시드가 건너뜀
SEED_EMPLOYEE_PASSWORD=DevEmployee!12345

# Background Check API (swagger.yaml 확인 후 채움)
BACKGROUND_CHECK_BASE_URL=https://54capvm12g.execute-api.ap-northeast-2.amazonaws.com
BACKGROUND_CHECK_API_KEY=
